# wallatag configuration. Copy to wallatag.toml (gitignored) and fill in.
# Every key here can be overridden by environment variables (see README).

[wallabag]
url = "https://wallabag.example.com"
client_id = "your_api_client_id"      # create in wallabag UI: Developer > Create your own client
client_secret = "your_api_client_secret"
username = "your_wallabag_username"   # the wallabag API authenticates via OAuth2 password grant (client + user credentials)
password = "your_wallabag_password"

[store]
# Path to the SQLite decision log. Leave empty/omit for history-less mode
# (no database at all: untagged articles may be re-presented, no learning data).
path = "/data/wallatag.db"

[tagger]
# Each key below can be overridden by an environment variable (see README):
# WALLATAG_MAX_SUGGESTIONS, WALLATAG_TAG_POLICY, WALLATAG_IGNORE_TAGS.
# WALLATAG_IGNORE_TAGS is comma-separated, e.g. "fix,_frigo"; "" clears the
# list (whitespace-only/comma-only values are rejected). Empty
# WALLATAG_TAG_POLICY / WALLATAG_MAX_SUGGESTIONS raise a ConfigError: unset
# the variable instead of setting it to "".
max_suggestions = 5
tag_policy = "prefer-existing"        # only-existing | prefer-existing | all
ignore_tags = ["fix", "_frigo"]       # tags treated as untagged: articles carrying ONLY these are still fetched
# Optional regex patterns (Python re syntax) matched IN ADDITION to ignore_tags:
# a tag counts as ignored if it equals a literal entry OR matches any pattern.
# Patterns are substring matches (re.search); anchor with ^...$ for a full-tag
# match — e.g. "(?-i:^fix$)" matches only the exact tag "fix", while an
# unanchored "(?-i:fix)" would also match tags like "prefixfix". Matching is
# case-insensitive by default; use inline (?-i:...) for case-sensitive
# sections — regexes read the raw tag label, so the override works. Invalid or
# empty/whitespace-only patterns are rejected at load. Env override:
# WALLATAG_IGNORE_TAGS_REGEX (comma-separated; like
# WALLATAG_FOCUS_<NAME>_KEYWORDS_REGEX, the value is split on every comma and
# each fragment is validated independently, so a comma inside a regex can
# SILENTLY change matching — regexes containing commas must use TOML).
ignore_tags_regex = []
# Per-source enable switches for the tagging mechanisms (strict booleans;
# env overrides: WALLATAG_ENABLE_VOCABULARY / WALLATAG_ENABLE_RULES /
# WALLATAG_ENABLE_LLM, values true/1/yes or false/0/no, case-insensitive).
enable_vocabulary = true              # existing-tag vocabulary matching
enable_rules = true                   # focus-group rule matching
enable_llm = false                    # LLM tagging is opt-in: set true to enable (requires [ai] provider/base_url/model)

# [vocabulary] fields: which article fields the existing-tag vocabulary
# matcher checks. Default (absent key): title, url, domain_name, content.
# An empty list [] disables vocabulary matching entirely. Field names are
# strict (exact, case-sensitive): only title, url, domain_name, content.
# Env override: WALLATAG_VOCABULARY_FIELDS (comma-separated, e.g. "title,url";
# "" disables).
[vocabulary]
fields = ["title", "url"]

# Named rule groups ("focus" areas). --focus NAME activates one; repeat the
# flag to activate several (e.g. --focus methods --focus languages); default = all.
# Each group's keywords/tags/fields/keywords_regex can also be overridden (or
# a new group defined) via environment variables: WALLATAG_FOCUS_<NAME>_KEYWORDS,
# WALLATAG_FOCUS_<NAME>_TAGS, WALLATAG_FOCUS_<NAME>_FIELDS and
# WALLATAG_FOCUS_<NAME>_KEYWORDS_REGEX, where NAME is
# the text between the prefix and the exact
# _KEYWORDS/_TAGS/_FIELDS/_KEYWORDS_REGEX suffix
# (may contain underscores; case-insensitive name, comma-separated values,
# merge by name, "" clears that field).
[focus.methods]
keywords = ["pomodoro", "gtd", "zettelkasten"]
tags = ["productivity", "method"]
# Optional regex patterns (Python re syntax) matched IN ADDITION to keywords:
# the group fires when ANY keyword OR ANY regex matches. Matching is per field
# (never across fields) and case-insensitive by default; use inline (?-i:...)
# for case-sensitive sections (e.g. "(?-i:GTD)") — regexes read the raw
# article fields, so the override works. Invalid or empty/whitespace-only
# patterns are rejected at load. Env override:
# WALLATAG_FOCUS_METHODS_KEYWORDS_REGEX (comma-separated; the value is split on
# every comma and each fragment is validated independently, so a comma inside a
# regex can SILENTLY change matching — regexes containing commas must use TOML
# keywords_regex; the Prefect WALLATAG_FOCUS_GROUPS JSON variable rejects them
# loudly for the same reason).
keywords_regex = []
# Which article fields THIS group's keywords match against. Default (absent):
# all four fields; an empty list [] disables this group's keyword matching.
# Same strict field names as [vocabulary] fields above.
fields = ["title", "content"]

[focus.languages]
keywords = ["python", "rust", "golang"]
tags = ["programming"]

# LLM auto-tagger: active when provider is set (ollama | openai-compatible).
# For ollama, base_url is the bare server (no /v1); for openai-compatible
# gateways include the version prefix, e.g. https://api.example.com/v1.
[ai]
provider = "ollama"
base_url = "http://localhost:11434"
model = "qwen2.5:3b"
confidence_threshold = 0.7        # only apply tags the model rates above this (0, 1]
api_key = ""                      # optional: bearer token for openai-compatible providers that require auth
# Whether focus groups influence LLM tagging. true (default): the LLM prompt
# lists the focus groups the article matches as "Focus areas" (groups with fields = [] are
# excluded). false: keyword-only mode, the LLM ignores focus groups entirely
# (the "Focus areas" line is omitted); focus-group keywords matter only for the
# keyword tagger. Env override: WALLATAG_AI_USE_FOCUS_GROUPS (true/1/yes, false/0/no).
use_focus_groups = true
# When true and the LLM tagger fails for an article (after retries are
# exhausted), the keyword tagger takes over for that article (per-article
# scope; the LLM is still tried on subsequent articles). The fallback behaves
# exactly like a normal keyword-mode run. Env override:
# WALLATAG_AI_FALLBACK_ON_FAIL (true/1/yes, false/0/no).
fallback_on_fail = false
